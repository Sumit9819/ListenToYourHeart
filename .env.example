# Comma-separated HTTPS origins. Keep these server-side and allowlisted.
PIPED_INSTANCES=https://api.piped.private.coffee,https://pipedapi.ducks.party
INVIDIOUS_INSTANCES=https://invidious.darkness.services,https://invidious.f5.si

# ---------------------------------------------------------------------------
# Optional: accounts and cross-device sync.
#
# Leave every variable below unset and the app behaves exactly as before — a
# local-first player whose library lives in the browser and needs no sign-in.
# Set all four and a "Sign in with Google" control appears, and each account's
# playlists, favorites and history follow them between devices.
#
# /api/accounts reports which of these are still missing.
# ---------------------------------------------------------------------------

# Postgres. Neon's pooled connection string is the one to use on Vercel.
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID.
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed when the deployment URL is not what Vercel reports, e.g. a
# custom domain or a preview you want sign-in to work on.
# BETTER_AUTH_URL=https://your-domain.example
